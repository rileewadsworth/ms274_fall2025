# Open-boundaries
 &OBCS_PARM01

 OBCSfixTopo=.FALSE.,

# West boundary only.
# -99 = no open boundary
# 1   = west boundary located at i=1
 OB_Iwest = 1*-99, 76*1, 163*-99,

# Explicitly close the other boundaries
 OB_Jsouth = 360*-99,
 OB_Jnorth = 360*-99,
 OB_Ieast  = 240*-99,

 useOBCSsponge = .TRUE.,

# Only use sponge near the west boundary
 OBCSSponge_N = .FALSE.,
 OBCSSponge_S = .FALSE.,
 OBCSSponge_E = .FALSE.,
 OBCSSponge_W = .TRUE.,

 useOBCSbalance = .FALSE.,
 useOBCSprescribe = .TRUE.,

# Prescribed west-boundary temperature and salinity
 OBWtFile = 'obcs/THETA_west_relax.bin',
 OBWsFile = 'obcs/SALT_west_relax.bin',

 &

 &OBCS_PARM02
 &

 &OBCS_PARM03
 spongeThickness = 10,
 Urelaxobcsinner = 1296000.E0,
 Vrelaxobcsinner = 1296000.E0,
 Urelaxobcsbound = 43200.E0,
 Vrelaxobcsbound = 43200.E0,
 &
